# Copy to .env and fill in. All values are read via os.getenv() in av_editor/config.py.

# --- LLM ---------------------------------------------------------------------
# Official Google Gemini API for planning, evaluation, and captioning.
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=gemini-2.5-flash
GEMINI_EVALUATOR_MODEL=gemini-3.1-pro-preview

# --- fal.ai media tools -------------------------------------------------------
# Wan, Seedance, MMAudio V2, Qwen3 TTS, Sync Lipsync 2, SAM Audio
FAL_KEY=
# Optional default video backend. Both wan and seedance use fal.ai.
VIDEO_BACKEND=wan
SEEDANCE_MODEL_VARIANT=2.0

# --- Audio separation --------------------------------------------------------
# Device for the local AudioSep fallback
AUDIOSEP_DEVICE=cuda
# Optional local AudioSep fallback paths
AUDIOSEP_REPO=
AUDIOSEP_CKPT=
AUDIOSEP_CFG=
